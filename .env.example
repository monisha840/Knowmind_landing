# ---------------------------------------------------------------------------
# KnowMind Universe — 1% Better. Every Day.
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored; this file is
# committed and must therefore never contain a real value.
# ---------------------------------------------------------------------------

# --- Razorpay -------------------------------------------------------------
# SERVER-SIDE ONLY. Neither of these is NEXT_PUBLIC_, and neither may ever
# become one: a NEXT_PUBLIC_ variable is compiled into the browser bundle.
# The key id does reach the browser, but only as part of an order-creation
# response from our own server (`/api/register`), never as build-time config.
#
# Test credentials: Dashboard → Account & Settings → API Keys (Test Mode).
# Live credentials are a separate pair — do not swap them in until the flow has
# been signed off in test mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook signing secret. This is a DIFFERENT value from RAZORPAY_KEY_SECRET:
# you choose it when creating the webhook at
# Dashboard → Settings → Webhooks → Add New Webhook, pointing at
# https://<your-domain>/api/razorpay/webhook with the events
# `payment.captured`, `payment.failed` and `order.paid`.
#
# While it is empty the webhook endpoint rejects every delivery with 503 rather
# than trusting an unsigned request. Checkout + server-side verification still
# work; the webhook is the belt-and-braces confirmation on top.
#
# REQUIRED IN PRODUCTION, now that /admin is the lead list. Without it, a
# payment whose browser never makes it back from checkout is confirmed by
# nothing: the money moves, /api/razorpay/verify is never called, and that
# person is never recorded as PAID. Create it with
#
#   npm run webhook:create -- https://<the origin this site is served from>
#
# and the dashboard shows a warning while it is unset.
RAZORPAY_WEBHOOK_SECRET=

# --- Registration mirror (optional) ---------------------------------------
# The durable registration record is the Razorpay order itself: every answer is
# written into the order's `notes`, so it survives without any database and is
# readable in the Razorpay dashboard. See `src/lib/payments/registrations.ts`.
#
# Setting these adds a Redis mirror over the REST API (zero npm dependencies),
# which gives fast lookup and an idempotency lock across serverless instances.
# Vercel KV and Upstash both expose exactly these two values.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Site -----------------------------------------------------------------
# Canonical origin, used for canonical tags, sitemap and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://www.knowminduniverse.com

# --- Registration database (Neon Postgres) --------------------------------
# The lead store behind /admin. Created through the Vercel Marketplace:
# Vercel dashboard -> your project -> Storage -> Neon -> Create. That injects
# DATABASE_URL into every environment automatically; `vercel env pull
# .env.local` brings it down for local work.
#
# Then apply the schema once:  npm run db:migrate
#
# Its absence is not fatal. Registration and payment carry on exactly as before
# (the Razorpay order's notes are still the durable record) and the writes are
# skipped with a log line — the fail-open policy in
# src/lib/payments/registrations.ts. What you lose is the lead list, and /admin
# says so rather than showing an empty table.
DATABASE_URL=

# --- Admin dashboard ------------------------------------------------------
# Generate BOTH of these with:  npm run admin:password
#
# It prompts for a password without echoing it, writes the scrypt hash here,
# and never stores, prints or logs the password itself. Never put a plaintext
# password in this file, in the repository, or in a commit message.
#
# ADMIN_PASSWORD_HASH   scrypt$<N>$<r>$<p>$<salt base64>$<hash base64>
# ADMIN_SESSION_SECRET  32+ bytes of hex; signs the session cookie. Rotating it
#                       logs everyone out, which is how a session is revoked in
#                       a design that deliberately has no session table.
#
# Both are server-side only. Neither may ever become NEXT_PUBLIC_.
# While either is empty, /admin shows an honest "not configured" notice and no
# password can be accepted.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# --- WhatsApp payment confirmations (Evolution Go) -------------------------
# Sent exactly once, automatically, from src/lib/whatsapp/notify.ts — never on
# form submission, never on "Checkout opened", never on the browser's say-so.
# The only trigger is the existing server-side Razorpay verification (the
# verify route and the webhook) actually marking a registration PAID. See the
# header comment in notify.ts for the full guarantee.
#
# SERVER-SIDE ONLY. None of these may ever become NEXT_PUBLIC_. While
# EVOLUTION_API_URL or EVOLUTION_API_KEY is empty, sending is skipped and
# logged — the same honest-boundary pattern as the Razorpay credentials above
# — and it never blocks or fails a payment.
#
# Requires DATABASE_URL (below) to be configured too: the one-message
# guarantee is an atomic database claim (see claimWhatsappSend in
# src/lib/db/registrations.ts), so without a database, sending is skipped
# entirely rather than risk sending twice.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# Not read by any request — Evolution Go's token is itself instance-scoped.
# Kept only so logs and the dashboard can name which instance a deployment is
# wired to.
EVOLUTION_INSTANCE=

# Redirects every outgoing WhatsApp confirmation to this number instead of the
# lead's own — the safe way to test the whole payment → WhatsApp path locally
# without messaging a real person. A plain digit string (no +, no spaces).
# Leave empty in production.
EVOLUTION_TEST_PHONE=

# Authenticates GET /api/whatsapp/retry, the Vercel Cron job (see vercel.json)
# that retries failed WhatsApp sends with backoff. Vercel sets
# `Authorization: Bearer <CRON_SECRET>` automatically when it invokes a
# scheduled route; while this is empty the route refuses every request,
# including Vercel's own.
CRON_SECRET=
