# ---------------------------------------------------------------------------
# KnowMind Universe — 1% Better. Every Day.
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored; this file is
# committed and must therefore never contain a real value.
# ---------------------------------------------------------------------------

# --- Razorpay -------------------------------------------------------------
# SERVER-SIDE ONLY. Neither of these is NEXT_PUBLIC_, and neither may ever
# become one: a NEXT_PUBLIC_ variable is compiled into the browser bundle.
# The key id does reach the browser, but only as part of an order-creation
# response from our own server (`/api/register`), never as build-time config.
#
# Test credentials: Dashboard → Account & Settings → API Keys (Test Mode).
# Live credentials are a separate pair — do not swap them in until the flow has
# been signed off in test mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook signing secret. This is a DIFFERENT value from RAZORPAY_KEY_SECRET:
# you choose it when creating the webhook at
# Dashboard → Settings → Webhooks → Add New Webhook, pointing at
# https://<your-domain>/api/razorpay/webhook with the events
# `payment.captured`, `payment.failed` and `order.paid`.
#
# While it is empty the webhook endpoint rejects every delivery with 503 rather
# than trusting an unsigned request. Checkout + server-side verification still
# work; the webhook is the belt-and-braces confirmation on top.
RAZORPAY_WEBHOOK_SECRET=

# --- Registration mirror (optional) ---------------------------------------
# The durable registration record is the Razorpay order itself: every answer is
# written into the order's `notes`, so it survives without any database and is
# readable in the Razorpay dashboard. See `src/lib/payments/registrations.ts`.
#
# Setting these adds a Redis mirror over the REST API (zero npm dependencies),
# which gives fast lookup and an idempotency lock across serverless instances.
# Vercel KV and Upstash both expose exactly these two values.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Site -----------------------------------------------------------------
# Canonical origin, used for canonical tags, sitemap and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://www.kaleeswaran.com
